# Conta sandbox runtime template.
# Copy to a local or server-only .env file and provide secrets out of band.
# Never commit real values.

CONTA_ENVIRONMENT=sandbox
CONTA_API_KEY=
CONTA_ORG_ID=
CONTA_MCP_BEARER_TOKEN=

# Keep every execution gate closed during read-only sandbox validation.
CONTA_ENABLE_WRITE_PREVIEW=true
CONTA_ENABLE_WRITE_TOOLS=false
CONTA_RUNTIME_WRITE_BLOCKED=true
CONTA_EXECUTION_ALLOWED=false
CONTA_PRODUCTION_WRITE_APPROVED=false
CONTA_ALLOWED_WRITE_ORG_IDS=
CONTA_ALLOWED_WRITE_ACTIONS=

